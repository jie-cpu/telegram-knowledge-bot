{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Community Platform Multi-Agent System Configuration",
  "description": "Validation schema for config.yaml. Ensures all parameters are valid before the system starts.",
  "type": "object",
  "required": ["orchestrator", "agents", "state", "llm"],
  "properties": {
    "orchestrator": {
      "type": "object",
      "required": ["model", "max_iterations", "timeout_minutes"],
      "properties": {
        "model": { "type": "string", "description": "LLM model for orchestration" },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 200 },
        "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "task_decomposition_depth": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "escalation_threshold": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "checkpoint_interval_seconds": { "type": "integer", "minimum": 30, "default": 300 },
        "heartbeat_interval_seconds": { "type": "integer", "minimum": 10, "default": 60 },
        "max_missed_heartbeats": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 }
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "se_agent": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.2 },
            "max_consecutive_failures": { "type": "integer", "minimum": 1, "default": 3 },
            "allowed_tools": { "type": "array", "items": { "type": "string" } },
            "sandbox_enabled": { "type": "boolean", "default": true },
            "languages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tester_agent": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "min_coverage": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
            "llm_judge_threshold": { "type": "number", "minimum": 0, "maximum": 10, "default": 6.0 },
            "property_based_tests": { "type": "boolean", "default": true },
            "max_test_iterations": { "type": "integer", "minimum": 1, "default": 3 }
          }
        },
        "oncall_agent": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "poll_interval_seconds": { "type": "integer", "minimum": 10, "default": 60 },
            "p99_latency_threshold_ms": { "type": "integer", "minimum": 100, "default": 500 },
            "error_rate_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.01 },
            "auto_rollback": { "type": "boolean", "default": true },
            "alert_grace_period_seconds": { "type": "integer", "minimum": 0, "default": 120 }
          }
        },
        "pm_agent": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "require_acceptance_criteria": { "type": "boolean", "default": true },
            "edge_case_depth": { "type": "string", "enum": ["minimal", "standard", "comprehensive"], "default": "comprehensive" }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": { "type": "string", "enum": ["sqlite", "postgresql"] },
        "checkpoint_interval_seconds": { "type": "integer", "minimum": 30, "default": 300 },
        "max_checkpoints": { "type": "integer", "minimum": 1, "default": 50 }
      }
    },
    "llm": {
      "type": "object",
      "required": ["default_provider", "providers"],
      "properties": {
        "default_provider": { "type": "string", "enum": ["openai", "anthropic", "ollama"] },
        "providers": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"], "default": "INFO" },
        "format": { "type": "string", "enum": ["json", "console"], "default": "json" }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "max_tokens_per_agent": { "type": "integer", "minimum": 10000, "default": 500000 },
        "max_cost_per_session_usd": { "type": "number", "minimum": 0.01, "default": 10.00 }
      }
    }
  }
}
