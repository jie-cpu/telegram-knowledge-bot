# =============================================================================
# Environment Variables — Community Platform Multi-Agent System
# =============================================================================
# Copy this file to .env and fill in your values.
# =============================================================================

# ── LLM Providers ──────────────────────────────────────────────────────────
# At least one provider must be configured.

OPENAI_API_KEY="sk-..."
OPENAI_ORG_ID="org-..."           # optional

ANTHROPIC_API_KEY="sk-ant-..."

DEEPSEEK_API_KEY="sk-..."

GEMINI_API_KEY="..."

# Local models (via Ollama) — no API key needed
# OLLAMA_BASE_URL="http://localhost:11434"

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD="changeme"

# ── Monitoring ─────────────────────────────────────────────────────────────
# GRAFANA_API_KEY="..."
# PROMETHEUS_PUSH_GATEWAY="http://localhost:9091"

# ── Logging ────────────────────────────────────────────────────────────────
# LOG_LEVEL="INFO"

# ── Security ───────────────────────────────────────────────────────────────
# MAX_COST_PER_SESSION_USD=10.00
