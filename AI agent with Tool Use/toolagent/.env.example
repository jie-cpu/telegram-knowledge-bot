# ── ToolAgent Configuration ─────────────────────────────────────────
# Copy this file to .env and modify as needed.
# The system runs out of the box in mock/demo mode without any API keys.

# LLM Provider: "openai", "anthropic", "deepseek", "gemini", or "mock"
LLM_PROVIDER=mock

# OpenAI settings
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Anthropic settings
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# DeepSeek settings (OpenAI-compatible API)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini settings
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# Agent Loop
MAX_STEPS=15
STEP_TIMEOUT_SECONDS=60
SESSION_TIMEOUT_SECONDS=600

# Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_INPUT_LENGTH=10000
GUARDRAILS_RATE_LIMIT_PER_MINUTE=30

# Observability
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_DIR=logs
